<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/autostart.sh; holds no secrets -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pharmaitchat.mlx-watchdog</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/mlx-watchdog.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
  </dict>
  <key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
  <!-- StartInterval, not KeepAlive: the failure this catches is a live process
       that stops generating, which KeepAlive cannot see. Two minutes is slower
       than a crash-restart but well inside the window where a wedged MLX would
       otherwise sit unnoticed for hours. -->
  <key>StartInterval</key><integer>120</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__PROJECT_DIR__/data/logs/mlx-watchdog.log</string>
  <key>StandardErrorPath</key><string>__PROJECT_DIR__/data/logs/mlx-watchdog.log</string>
</dict>
</plist>
