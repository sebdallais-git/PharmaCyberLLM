<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/autostart.sh; holds no secrets (start-services.sh reads the token files) -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pharmaitchat.stack</string>
  <!-- start-services.sh brings up ChromaDB, the active LLM stack and the app,
       then blocks on `wait`. Blocking is what makes it a good launchd job: the
       process stays alive for as long as the stack is meant to be up, so
       KeepAlive covers the whole group rather than any single piece. It reads
       data/run/active-stack, so a reboot comes back on the stack that was live. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/start-services.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
  </dict>
  <key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <!-- The MLX model load alone takes tens of seconds; a short throttle would
       have launchd relaunching while the previous attempt is still starting. -->
  <key>ThrottleInterval</key><integer>60</integer>
  <!-- start-services.sh traps SIGTERM and kills its process group, so give it
       room to take the app and the MLX servers down cleanly. -->
  <key>ExitTimeOut</key><integer>30</integer>
  <key>StandardOutPath</key><string>__PROJECT_DIR__/data/logs/stack.log</string>
  <key>StandardErrorPath</key><string>__PROJECT_DIR__/data/logs/stack.log</string>
</dict>
</plist>
