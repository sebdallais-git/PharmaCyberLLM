<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Rendered by scripts/hermes-setup.sh install-services; holds no secrets (n8n reads its own credentials from ~/.n8n) -->
<plist version="1.0">
<dict>
  <key>Label</key><string>com.pharmaitchat.n8n</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/run-n8n.sh</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
    <key>N8N_PORT</key><string>__N8N_PORT__</string>
  </dict>
  <key>WorkingDirectory</key><string>__PROJECT_DIR__</string>
  <key>RunAtLoad</key><true/>
  <!-- The reason this exists: n8n was down for long enough that the gap loop
       was dead and nobody noticed, because the app logs a caught ECONNREFUSED
       and carries on. KeepAlive makes that failure mode self-correcting. -->
  <key>KeepAlive</key><true/>
  <!-- n8n takes ~40s to start from a cold npx cache; a short throttle would
       hammer it while it is still coming up. -->
  <key>ThrottleInterval</key><integer>30</integer>
  <key>StandardOutPath</key><string>__PROJECT_DIR__/data/logs/n8n.log</string>
  <key>StandardErrorPath</key><string>__PROJECT_DIR__/data/logs/n8n.log</string>
</dict>
</plist>
